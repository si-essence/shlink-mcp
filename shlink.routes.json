      "method": "GET",
      "path": "/rest/v{version}/short-urls",
      "operationId": "listShortUrls",
      "summary": "List short URLs",
      "toolset": "short_urls",
      "action": "list",
      "auth": "key",
      "write": false,
      "exclude": false
    },
    {
      "method": "POST",
      "path": "/rest/v{version}/short-urls",
      "operationId": "createShortUrl",
      "summary": "Create short URL",
      "toolset": "short_urls_write",
      "action": "create",
      "auth": "key",
      "write": true,
      "exclude": false
    },
    {
      "method": "GET",
      "path": "/rest/v{version}/short-urls/shorten",
      "operationId": "shortenUrl",
      "summary": "Create a short URL",
      "exclude": true,
      "reason": "Deprecated GET create. The operation accepts apiKey as a query parameter. Use createShortUrl, which sends X-Api-Key and never puts the key in the URL."
    },
