      "exclude": true,
      "reason": "Public redirect at /{shortCode}. It is not the REST API. A request records a visit and returns 302. Hit it with plain HTTP, outside this connector."
    },
    {
      "method": "GET",
      "path": "/{shortCode}/track",
      "operationId": "trackShortUrl",
      "summary": "Short URL tracking pixel",
